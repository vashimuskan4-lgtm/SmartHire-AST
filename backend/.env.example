# Port for local development (Render automatically assigns PORT in production)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/SmartHire?retryWrites=true&w=majority

# JWT secret key for signing tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL(s) allowed by CORS (comma-separated if multiple, e.g. production and preview domains)
# Example: https://smarthire-ats.vercel.app,*.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app,*.vercel.app